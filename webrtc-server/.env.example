# Port for Render Web Service (Render automatically sets PORT=10000)
PORT=10000

# Server Host (bind to all interfaces for Render container)
HOST=0.0.0.0

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Client Origins allowed for CORS (comma-separated URLs, or * for all)
CLIENT_URL=https://hyna-management.onrender.com,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173
